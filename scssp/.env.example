# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://fortifyci:fortifyci_password@localhost:5432/fortifyci?schema=public
DATABASE_URL_TEST=postgresql://fortifyci:fortifyci_password@localhost:5433/fortifyci_test?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT RS256
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=fortifyci
JWT_AUDIENCE=fortifyci-api

# Encryption
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
ENCRYPTION_IV_LENGTH=16

# Argon2id
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fortifyci-images
MINIO_USE_SSL=false

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@fortifyci.example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@fortifyci.example.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Trivy
TRIVY_BIN_PATH=trivy
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db:2
TRIVY_JAVA_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-java-db:1
TRIVY_TIMEOUT=300000
TRIVY_CACHE_DIR=./.trivy-cache

# Worker
WORKER_CONCURRENCY=5
SCAN_TIMEOUT_MS=300000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# Additional SMTP
EMAIL_FROM_NAME=FortifyCI

# Cookie
COOKIE_SECRET=your-cookie-secret-here
