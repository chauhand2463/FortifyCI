generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  DEVELOPER
  SECURITY_ANALYST
  VIEWER
}

enum PermissionName {
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE
  ROLE_CREATE
  ROLE_READ
  ROLE_UPDATE
  ROLE_DELETE
  IMAGE_REGISTER
  IMAGE_READ
  IMAGE_DELETE
  SCAN_CREATE
  SCAN_READ
  SCAN_CANCEL
  VULNERABILITY_READ
  VULNERABILITY_EXPORT
  SBOM_CREATE
  SBOM_READ
  SBOM_DELETE
  REPORT_CREATE
  REPORT_READ
  REPORT_DOWNLOAD
  REPORT_DELETE
  NOTIFICATION_READ
  NOTIFICATION_MANAGE
  AUDIT_LOG_READ
  AUDIT_LOG_EXPORT
  JOB_READ
  JOB_CANCEL
  API_KEY_CREATE
  API_KEY_READ
  API_KEY_DELETE
  VULNERABILITY_ASSIGN
  VULNERABILITY_EXCEPTION
  WEBHOOK_MANAGE
  POLICY_MANAGE
  LIVE_SCAN_CREATE
}

enum ScanStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum SBOMFormat {
  SPDX
  CYCLONEDX
}

enum ReportFormat {
  PDF
  CSV
  JSON
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum NotificationType {
  SCAN_COMPLETED
  VULNERABILITY_FOUND
  REPORT_READY
  SYSTEM_ALERT
  SCAN_REGRESSION
  SLA_BREACHED
  ASSIGNMENT_CREATED
  EXCEPTION_EXPIRED
  NVD_CRITICAL_CVE
  EXCEPTION_APPROVED
  EXCEPTION_CREATED
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
}

enum JobType {
  SCAN_IMAGE
  GENERATE_SBOM
  GENERATE_REPORT
  SEND_NOTIFICATION
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
}

enum RemediationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum LiveScanStatus {
  PENDING
  PULLING
  SCANNING
  EVALUATING
  PASSED
  BLOCKED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  images        Image[]
  scans         Scan[]
  sboms         SBOM[]
  reports       Report[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  sessions           Session[]
  apiKeys            ApiKey[]
  refreshTokens      RefreshToken[]
  liveScans          LiveScan[]
  assignedVulns      VulnerabilityAssignment[] @relation("AssignedTo")
  assignedByVulns    VulnerabilityAssignment[] @relation("AssignedBy")
  createdExceptions  VulnerabilityException[] @relation("ExceptionCreator")
  approvedExceptions VulnerabilityException[] @relation("ExceptionApprover")
  revokedExceptions  VulnerabilityException[] @relation("ExceptionRevoker")

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String         @id @default(uuid())
  name        PermissionName @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rolePermissions RolePermission[]

  @@index([name])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Image {
  id            String    @id @default(uuid())
  name          String
  tag           String
  digest        String?
  registry      String    @default("docker.io")
  repository    String
  architecture  String?
  os            String?
  size          BigInt?
  mediaType     String?
  registryCredentials Json?
  manifest      Json?
  config        Json?
  labels        Json?
  isSigned      Boolean   @default(false)
  signatureInfo Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  scans             Scan[]
  sboms             SBOM[]
  reports           Report[]
  postureSnapshots  PostureSnapshot[]
  exceptions        VulnerabilityException[]

  @@unique([name, tag, registry, repository, deletedAt])
  @@index([name])
  @@index([repository])
  @@index([userId])
  @@index([deletedAt])
  @@map("images")
}

model Scan {
  id           String     @id @default(uuid())
  imageRef     String
  scanType     String     @default("trivy")
  status       ScanStatus @default(PENDING)
  progress     Int        @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  metadata     Json?
  retryCount   Int        @default(0)
  maxRetries   Int        @default(3)
  triggeredBy  String?    @default("USER")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  imageId String
  image   Image  @relation(fields: [imageId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  vulnerabilities Vulnerability[]
  packages        Package[]
  sboms           SBOM[]
  reports         Report[]
  jobId           String?         @unique
  job             Job?            @relation("ScanJob", fields: [jobId], references: [id])
  diff            ScanDiff?       @relation("NewerScan")
  baselineDiff    ScanDiff?       @relation("BaselineScan")
  postureSnapshot PostureSnapshot?

  @@index([status])
  @@index([imageId])
  @@index([userId])
  @@index([createdAt])
  @@map("scans")
}

model Package {
  id        String   @id @default(uuid())
  name      String
  version   String
  ecosystem String
  purl      String?
  createdAt DateTime @default(now())

  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([name])
  @@index([purl])
  @@map("packages")
}

model Vulnerability {
  id               String    @id @default(uuid())
  vulnerabilityId  String
  packageName      String?
  packageVersion   String?
  packageType      String?
  pkgName          String?
  pkgVersion       String?
  severity         Severity  @default(UNKNOWN)
  cvssScore        Float?
  cvssVector       String?
  cweIds           Json?
  title            String?
  description      String?
  fixedVersion     String?
  publishedDate    DateTime?
  lastModifiedDate DateTime?
  source           String    @default("trivy")
  referenceUrls    Json?
  exploitAvailable Boolean?
  epssScore        Float?
  layerInfo        Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  assignment VulnerabilityAssignment?

  @@index([vulnerabilityId])
  @@index([severity])
  @@index([scanId])
  @@index([packageName])
  @@index([pkgName])
  @@index([vulnerabilityId, scanId])
  @@map("vulnerabilities")
}

model VulnerabilityAssignment {
  id              String            @id @default(cuid())
  vulnerabilityId String
  vulnerability   Vulnerability     @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  assignedToId    String
  assignedTo      User              @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById    String
  assignedBy      User              @relation("AssignedBy", fields: [assignedById], references: [id])
  status          RemediationStatus @default(OPEN)
  slaDeadline     DateTime
  slaBreached     Boolean           @default(false)
  slaBreachedAt   DateTime?
  resolvedAt      DateTime?
  resolvingScanId String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([vulnerabilityId])
  @@index([assignedToId])
  @@index([status])
  @@index([slaDeadline])
  @@index([slaBreached])
  @@map("vulnerability_assignments")
}

model VulnerabilityException {
  id            String    @id @default(cuid())
  cveId         String
  imageId       String?
  image         Image?    @relation(fields: [imageId], references: [id])
  reason        String
  createdById   String
  createdBy     User      @relation("ExceptionCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("ExceptionApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  isActive      Boolean   @default(false)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedById   String?
  revokedBy     User?     @relation("ExceptionRevoker", fields: [revokedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([cveId, isActive])
  @@index([expiresAt])
  @@map("vulnerability_exceptions")
}

model ScanPolicy {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  blockOnCritical  Boolean  @default(true)
  blockOnHigh      Boolean  @default(false)
  maxHighCount     Int      @default(0)
  maxMediumCount   Int      @default(-1)
  slaCriticalDays  Int      @default(7)
  slaHighDays      Int      @default(30)
  slaMediumDays    Int      @default(90)
  registryPatterns String[]
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  liveScans LiveScan[]

  @@index([name])
  @@index([isDefault])
  @@map("scan_policies")
}

model Webhook {
  id          String             @id @default(cuid())
  name        String
  url         String
  secret      String
  events      String[]
  isActive    Boolean            @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  httpStatus   Int?
  responseBody String?
  success      Boolean
  attemptCount Int      @default(1)
  deliveredAt  DateTime @default(now())

  @@index([webhookId, deliveredAt])
  @@map("webhook_deliveries")
}

model CveWatch {
  id             String    @id @default(cuid())
  cveId          String    @unique
  publishedAt    DateTime
  severity       Severity
  cvssScore      Float?
  affectedImages String[]
  rescanCount    Int       @default(0)
  processed      Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([cveId])
  @@index([processed, createdAt])
  @@index([severity])
  @@map("cve_watches")
}

model PostureSnapshot {
  id              String   @id @default(cuid())
  imageId         String
  image           Image    @relation(fields: [imageId], references: [id])
  scanId          String   @unique
  scan            Scan     @relation(fields: [scanId], references: [id])
  criticalCount   Int      @default(0)
  highCount       Int      @default(0)
  mediumCount     Int      @default(0)
  lowCount        Int      @default(0)
  fixableCount    Int      @default(0)
  suppressedCount Int      @default(0)
  postureScore    Float
  snapshotAt      DateTime @default(now())

  @@index([imageId, snapshotAt])
  @@index([snapshotAt])
  @@map("posture_snapshots")
}

model ScanDiff {
  id                 String   @id @default(cuid())
  scanId             String   @unique
  scan               Scan     @relation("NewerScan", fields: [scanId], references: [id])
  baselineScanId     String   @unique
  baselineScan       Scan     @relation("BaselineScan", fields: [baselineScanId], references: [id])
  introducedCount    Int      @default(0)
  resolvedCount      Int      @default(0)
  persistedCount     Int      @default(0)
  deltaScore         Int      @default(0)
  regressionDetected Boolean  @default(false)
  introducedCveIds   String[]
  resolvedCveIds     String[]
  computedAt         DateTime @default(now())

  @@index([scanId])
  @@index([baselineScanId])
  @@map("scan_diffs")
}

model LiveScan {
  id             String         @id @default(cuid())
  requestedById  String
  requestedBy    User           @relation(fields: [requestedById], references: [id])
  imageRef       String
  imageDigest    String?
  policyId       String?
  policy         ScanPolicy?    @relation(fields: [policyId], references: [id])
  status         LiveScanStatus @default(PENDING)
  progress       Int            @default(0)
  passed         Boolean?
  blockingReason String?
  downloadUrl    String?
  downloadExpiry DateTime?
  linkedScanId   String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([requestedById])
  @@index([imageDigest])
  @@index([status])
  @@index([createdAt])
  @@map("live_scans")
}

model SBOM {
  id           String     @id @default(uuid())
  format       SBOMFormat
  version      String
  specVersion  String?
  content      Json
  rawDocument  Json?
  packageCount Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  imageId String
  image   Image  @relation(fields: [imageId], references: [id])
  scanId  String?
  scan    Scan?  @relation(fields: [scanId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@index([format])
  @@index([imageId])
  @@index([scanId])
  @@index([userId])
  @@index([createdAt])
  @@map("sboms")
}

model Report {
  id          String       @id @default(uuid())
  title       String
  format      ReportFormat
  status      ReportStatus @default(GENERATING)
  parameters  Json?
  filePath    String?
  fileSize    Int?
  generatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  scanId  String?
  scan    Scan?   @relation(fields: [scanId], references: [id])
  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id])

  @@index([format])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("reports")
}

model Notification {
  id           String              @id @default(uuid())
  type         NotificationType
  channel      NotificationChannel @default(EMAIL)
  subject      String
  body         String
  metadata     Json?
  isRead       Boolean             @default(false)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([type])
  @@index([sentAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@index([action, entity])
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  permissions Json?    @default("[]")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model Job {
  id          String    @id @default(uuid())
  type        JobType
  status      JobStatus @default(PENDING)
  payload     Json
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  priority    Int       @default(0)
  delay       Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  scan Scan? @relation("ScanJob")

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}
