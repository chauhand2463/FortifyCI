# ─── FortifyCI Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit the actual .env file — it is in .gitignore.

# Encryption key for AES-256-GCM (64 hex chars / 32 bytes)
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_real_64_hex_char_key

# CORS origin for production (no trailing slash)
CORS_ORIGIN=http://localhost:4000
