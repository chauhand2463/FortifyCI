# ─── FortifyCI Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit the actual .env file — it is in .gitignore.

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://fortifyci:fortifyci_password@localhost:5432/fortifyci?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT RS256 keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Encryption (AES-256-GCM) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_real_64_hex_char_key

# CORS origin for production
CORS_ORIGIN=http://localhost:4000

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fortifyci-images
MINIO_USE_SSL=false

# SMTP (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@fortifyci.example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@fortifyci.example.com
EMAIL_FROM_NAME=FortifyCI

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Trivy scanner
TRIVY_BIN_PATH=trivy
TRIVY_CACHE_DIR=./.trivy-cache
TRIVY_TIMEOUT=300000

# Worker
WORKER_CONCURRENCY=5
SCAN_TIMEOUT_MS=300000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# Cookie
COOKIE_SECRET=your-cookie-secret-here
